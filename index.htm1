
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nikan Shop | نیکان شاپ</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Tahoma, Arial, sans-serif;
      background: #fff9fb;
      color: #352631;
    }
    header {
      background: #9d456f;
      color: white;
      padding: 22px 16px;
      text-align: center;
    }
    header h1 { margin: 0 0 8px; }
    header p { margin: 0; }
    nav {
      background: #fff;
      padding: 14px;
      text-align: center;
      border-bottom: 1px solid #f0dce6;
    }
    nav a {
      color: #8b315e;
      text-decoration: none;
      margin: 0 10px;
      font-weight: bold;
    }
    .hero {
      padding: 42px 20px;
      text-align: center;
      background: linear-gradient(135deg, #f9dce9, #fff1f6);
    }
    .hero h2 { font-size: 28px; }
    .hero p { line-height: 2; }
    .search {
      display: block;
      width: min(90%, 500px);
      margin: 22px auto;
      padding: 13px;
      border: 1px solid #e5bfd0;
      border-radius: 10px;
      font-size: 16px;
    }
    main { max-width: 1100px; margin: auto; padding: 22px; }
    h2.section-title { text-align: center; margin: 28px 0; }
    .categories {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-bottom: 25px;
    }
    button {
      cursor: pointer;
      font-family: inherit;
    }
    .category, .buy {
      border: 0;
      border-radius: 9px;
      padding: 11px 16px;
      background: #9d456f;
      color: white;
    }
    .category { background: #f1dce6; color: #76284f; }
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 18px;
    }
    .product {
      background: white;
      border: 1px solid #f0dce6;
      border-radius: 15px;
      padding: 18px;
      text-align: center;
      box-shadow: 0 4px 15px #5c16320c;
    }
    .product .photo {
      background: #fff0f6;
      border-radius: 12px;
      font-size: 58px;
      padding: 22px;
    }
    .product h3 { margin-bottom: 8px; }
    .price { color: #9d456f; font-weight: bold; }
    .buy { width: 100%; margin-top: 8px; }
    .cart {
      margin: 30px 0;
      padding: 20px;
      background: white;
      border: 1px solid #f0dce6;
      border-radius: 14px;
    }
    .cart li { margin: 12px 0; }
    .remove {
      margin-right: 8px;
      border: 0;
      background: #f8e3ec;
      padding: 5px 9px;
      border-radius: 6px;
    }
    .checkout {
      display: inline-block;
      margin-top: 12px;
      padding: 13px 18px;
      border-radius: 9px;
      color: white;
      background: #218653;
      text-decoration: none;
    }
    .notice {
      font-size: 13px;
      color: #765b69;
      line-height: 1.9;
    }
    footer {
      margin-top: 35px;
      padding: 25px;
      text-align: center;
      background: #70294d;
      color: white;
      line-height: 2;
    }
  </style>
</head>
<body>

<header>
  <h1>🌸 Nikan Shop | نیکان شاپ</h1>
  <p>زیبایی و مراقبت، با انتخابی مطمئن</p>
</header>

<nav>
  <a href="#home">صفحه اصلی</a>
  <a href="#products">محصولات</a>
  <a href="#cart">سبد خرید</a>
  <a href="#contact">تماس با ما</a>
</nav>

<section class="hero" id="home">
  <h2>به نیکان شاپ خوش آمدید 💗</h2>
  <p>محصولات آرایشی و بهداشتی مورد علاقه‌ات را اینجا پیدا کن.</p>
  <p>محصولات دلخواهت را انتخاب کن و به سبد خرید اضافه کن.</p>
</section>

<main>
  <input
    class="search"
    id="search"
    type="search"
    placeholder="🔎 جست‌وجوی محصول..."
    aria-label="جست‌وجوی محصول"
  >

  <h2 class="section-title" id="products">محصولات فروشگاه</h2>

  <div class="categories">
    <button class="category" onclick="filterProducts('همه')">همه محصولات</button>
    <button class="category" onclick="filterProducts('آرایشی')">لوازم آرایشی</button>
    <button class="category" onclick="filterProducts('پوست')">مراقبت پوست</button>
    <button class="category" onclick="filterProducts('بهداشتی')">بهداشتی</button>
  </div>

  <section class="products" id="productList"></section>

  <section class="cart" id="cart">
    <h2>🛍️ سبد خرید</h2>
    <ul id="cartItems">
      <li>هنوز محصولی انتخاب نکرده‌اید.</li>
    </ul>
    <h3>مجموع: <span id="total">۰</span> تومان</h3>
    <button class="buy" onclick="checkout()">ثبت سفارش در واتساپ</button>
    <p class="notice">
      برای ثبت سفارش، شماره واتساپ فروشگاه را در کد تنظیم کنید.
      پرداخت بانکی آنلاین هنوز فعال نشده است.
    </p>
  </section>

  <section id="contact">
    <h2>تماس با نیکان شاپ</h2>
    <p>برای پرسش درباره محصولات و سفارش‌ها با فروشگاه تماس بگیرید.</p>
    <p>شماره تماس: شماره خودتان را اینجا وارد کنید.</p>
  </section>
</main>

<footer>
  <strong>Nikan Shop | نیکان شاپ</strong>
  <div>فروشگاه آنلاین لوازم آرایشی و بهداشتی</div>
  <div>© تمامی حقوق محفوظ است.</div>
</footer>

<script>
  // محصولات نمونه؛ نام و قیمت را با محصولات واقعی خود جایگزین کنید.
  const products = [
    { id: 1, name: "رژ لب", category: "آرایشی", price: 250000, emoji: "💄" },
    { id: 2, name: "ریمل", category: "آرایشی", price: 320000, emoji: "🖤" },
    { id: 3, name: "کرم مرطوب‌کننده", category: "پوست", price: 280000, emoji: "🧴" },
    { id: 4, name: "ضد آفتاب", category: "پوست", price: 450000, emoji: "☀️" },
    { id: 5, name: "شامپو", category: "بهداشتی", price: 180000, emoji: "🧴" },
    { id: 6, name: "ماسک صورت", category: "پوست", price: 150000, emoji: "🧖🏻‍♀️" },
    { id: 7, name: "پنکک", category: "آرایشی", price: 390000, emoji: "🌸" },
    { id: 8, name: "کرم دست", category: "بهداشتی", price: 120000, emoji: "🤍" }
  ];

  let cart = [];
  let currentCategory = "همه";

  const money = number => number.toLocaleString("fa-IR");

  function renderProducts() {
    const search = document.getElementById("search").value.trim().toLowerCase();

    const filtered = products.filter(product => {
      const categoryMatch =
        currentCategory === "همه" || product.category === currentCategory;
      const searchMatch = product.name.toLowerCase().includes(search);
      return categoryMatch && searchMatch;
    });

    const list = document.getElementById("productList");

    if (!filtered.length) {
      list.innerHTML = "<p>محصولی پیدا نشد.</p>";
      return;
    }

    list.innerHTML = filtered.map(product => `
      <article class="product">
        <div class="photo">${product.emoji}</div>
        <h3>${product.name}</h3>
        <p>${product.category}</p>
        <p class="price">${money(product.price)} تومان</p>
        <button class="buy" onclick="addToCart(${product.id})">
          افزودن به سبد خرید
        </button>
      </article>
    `).join("");
  }

  function filterProducts(category) {
    currentCategory = category;
    renderProducts();
  }

  function addToCart(id) {
    const product = products.find(item => item.id === id);
    const existing = cart.find(item => item.id === id);

    if (existing) {
      existing.quantity++;
    } else {
      cart.push({ ...product, quantity: 1 });
    }

    renderCart();
  }

  function removeFromCart(id) {
    cart = cart.filter(item => item.id !== id);
    renderCart();
  }

  function renderCart() {
    const list = document.getElementById("cartItems");

    if (!cart.length) {
      list.innerHTML = "<li>هنوز محصولی انتخاب نکرده‌اید.</li>";
    } else {
      list.innerHTML = cart.map(item => `
        <li>
          ${item.name} — تعداد: ${money(item.quantity)}
          — ${money(item.price * item.quantity)} تومان
          <button class="remove" onclick="removeFromCart(${item.id})">
            حذف
          </button>
        </li>
      `).join("");
    }

    const total = cart.reduce(
      (sum, item) => sum + item.price * item.quantity, 0
    );

    document.getElementById("total").textContent = money(total);
  }

  function checkout() {
    if (!cart.length) {
      alert("ابتدا محصولی به سبد خرید اضافه کنید.");
      return;
    }

    // شماره واتساپ را با کد کشور وارد کنید؛ فقط عدد، بدون + یا فاصله.
    const whatsappNumber = "989121234567";

    const lines = cart.map(item =>
      `${item.name} - تعداد ${item.quantity} - ${money(item.price * item.quantity)} تومان`
    );

    const total = cart.reduce(
      (sum, item) => sum + item.price * item.quantity, 0
    );

    const message =
      "سلام، برای ثبت سفارش از نیکان شاپ:\n" +
      lines.join("\n") +
      "\nمجموع: " + money(total) + " تومان";

    const url =
      "https://wa.me/" + whatsappNumber +
      "?text=" + encodeURIComponent(message);

    window.open(url, "_blank");
  }

  document.getElementById("search").addEventListener("input", renderProducts);
  renderProducts();
  renderCart();
</script>

</body>
</html>
